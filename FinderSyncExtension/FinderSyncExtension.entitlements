<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Finder Sync extensions must be sandboxed.
	  The temporary-exception below grants read/write to the whole filesystem
	  so the extension can create files in any Finder directory.
	  This is fine for direct (non-App Store) distribution signed with a
	  Developer ID certificate. For App Store submission, replace this with
	  a specific path or use an XPC service in the host app to create files.
	-->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.temporary-exception.files.absolute-path.read-write</key>
	<string>/</string>
</dict>
</plist>
